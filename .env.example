# Clubz Spin contracts. Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- RPC and verify
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASESCAN_API_KEY=

# ---------------------------------------------------------------- Chainlink VRF 2.5
# Coordinator address for the target chain. Take these from the Chainlink VRF
# subscription page rather than from any document, including this one.
VRF_COORDINATOR=
VRF_SUBSCRIPTION_ID=
VRF_KEY_HASH=

# Callback only stores one word and emits, so it is small and near-constant. Leave
# headroom over the measured cost rather than trimming this to the bone: an
# under-funded callback reverts, and a reverting VRF callback destroys the seed.
VRF_CALLBACK_GAS_LIMIT=500000

# Minimum permitted by the coordinator. Raising it increases reveal latency directly,
# which the spin animation has to cover, so do not raise it without a reason.
VRF_REQUEST_CONFIRMATIONS=3

# false = subscription funded in LINK, true = funded in native ETH.
VRF_NATIVE_PAYMENT=false

# ---------------------------------------------------------------- Roles
# Hot key held by the Spin worker. Commits contests and batches. Rotatable.
SPIN_OPERATOR=

# Safe multisig that owns the registry and the assignment contract. Deployment does
# NOT hand over automatically; transfer and accept as two deliberate steps.
SPIN_SAFE=
